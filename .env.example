# Everything here is optional - `docker compose up -d --build` works without a .env file.

# Flask session signing key. If unset, one is generated on first start and kept in
# the checkin_app_data volume.
# SECRET_KEY=

# Postgres credentials (shared by the postgres and app containers). Postgres is not
# published to the host. These only take effect when the database volume is first created.
# POSTGRES_USER=checkin
# POSTGRES_PASSWORD=checkin
# POSTGRES_DB=checkin

# Host port the app is published on (e.g. 127.0.0.1:8000 to only allow a local reverse proxy)
# APP_PORT=8000

# Staff login cookies are only sent over HTTPS by default. If the app is reached over
# plain HTTP (no TLS reverse proxy in front), set this to false or logins won't stick.
# SESSION_COOKIE_SECURE=true

# Hours of inactivity before a staff login expires.
# SESSION_LIFETIME_HOURS=12

# Password for the admin login created on first start. If unset, a random one is
# generated and printed in `docker compose logs app`. Must be changed on first login.
# ADMIN_PASSWORD=
