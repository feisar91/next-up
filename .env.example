# Everything here is optional - `docker compose up -d` works without a .env file.

# Which release of Next Up to run: "latest", or a version such as 1.0 (newest 1.0.x)
# or 1.0.0 (exactly that one). Upgrade with `docker compose pull && docker compose up -d`.
# NEXT_UP_VERSION=latest

# Flask session signing key. If unset, one is generated on first start and kept in
# the checkin_app_data volume.
# SECRET_KEY=

# Postgres credentials (shared by the postgres and app containers). Postgres is not
# published to the host. These only take effect when the database volume is first created.
# POSTGRES_USER=checkin
# POSTGRES_PASSWORD=checkin
# POSTGRES_DB=checkin

# Your shop's timezone (a name like Europe/London or America/New_York), used until an
# admin picks one under Admin > Settings. UTC if unset.
# TIMEZONE=

# Host port the app is published on (e.g. 127.0.0.1:8000 to only allow a local reverse proxy)
# APP_PORT=8000

# Staff login cookies are only sent over HTTPS by default. If the app is reached over
# plain HTTP (no TLS reverse proxy in front), set this to false or logins won't stick.
# SESSION_COOKIE_SECURE=true

# Hours of inactivity before a staff login expires.
# SESSION_LIFETIME_HOURS=12
# How often (seconds) to take barbers with no live login off duty after that long.
# OFF_DUTY_CHECK_SECONDS=300
# How often (seconds) to open or close stores that follow their opening hours,
# i.e. at most how late after the listed time it happens.
# OPENING_HOURS_CHECK_SECONDS=30
# How often (seconds) to clear customers left in a queue from before today.
# QUEUE_CLEANUP_CHECK_SECONDS=300

# Login rate limiting: failed attempts allowed per username and per IP address
# within the lockout window before further attempts are refused. The per-IP limit
# is higher because all the devices at a shop usually share one address.
# LOGIN_MAX_FAILURES_PER_USER=5
# LOGIN_MAX_FAILURES_PER_IP=20
# LOGIN_LOCKOUT_MINUTES=15

# Set to true when a reverse proxy (Nginx, Caddy) sits in front of the app, so
# rate limiting sees each visitor's real IP rather than the proxy's.
# BEHIND_PROXY=false

# Normally you create the admin login in the browser on first visit. For an unattended
# install, set this instead: an "admin" login is created with it on first start (at
# least 8 characters), and must be changed on first login.
# ADMIN_PASSWORD=
